#!/bin/bash

# pantheon-scrub
# Automated repo cleanup for Pantheon deployments
#
# NOTE: This is a Pantheon Professional Services tool, not an official Pantheon product.
#
# Scrubs away commits that violate Pantheon git hooks and fixes symlinks
#
# Usage: pantheon-scrub [command] [options]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Icons
CHECK="${GREEN}✓${NC}"
CROSS="${RED}✗${NC}"
WARN="${YELLOW}⚠${NC}"
INFO="${BLUE}ℹ${NC}"
ARROW="${CYAN}→${NC}"
SCRUB="${CYAN}🧹${NC}"

# Reserved paths that Pantheon doesn't allow
RESERVED_PATHS=(
    "wp-content/uploads"
    "sites/default/files"
    "web/sites/default/files"
    "web/wp-content/uploads"
)

RESERVED_FILES=(
    "pantheon.upstream.yml"
)

# Helper functions
print_header() {
    echo -e "\n${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}${CYAN}$1${NC}"
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

print_success() {
    echo -e "${CHECK} ${GREEN}$1${NC}"
}

print_error() {
    echo -e "${CROSS} ${RED}$1${NC}"
}

print_warning() {
    echo -e "${WARN} ${YELLOW}$1${NC}"
}

print_info() {
    echo -e "${INFO} ${CYAN}$1${NC}"
}

print_step() {
    echo -e "${ARROW} ${BOLD}$1${NC}"
}

# Check if git-filter-repo is installed
check_dependencies() {
    if ! command -v git-filter-repo &> /dev/null; then
        print_error "git-filter-repo is not installed"
        echo ""
        echo "Install it with:"
        echo "  macOS:   brew install git-filter-repo"
        echo "  Linux:   pip install git-filter-repo"
        echo "  Other:   https://github.com/newren/git-filter-repo"
        exit 1
    fi
}

# Get repository path
get_repo_path() {
    REPO_PATH="${1:-.}"
    if [ ! -d "$REPO_PATH/.git" ]; then
        print_error "Not a git repository: $REPO_PATH"
        exit 1
    fi
    cd "$REPO_PATH"
}

# Scan for issues
cmd_scan() {
    print_header "🧹 Scrubbing Repository - Scan Mode"

    get_repo_path "$1"

    local issues_found=0

    # Check reserved paths
    print_step "Checking for commits modifying reserved paths..."
    echo ""

    for path in "${RESERVED_PATHS[@]}"; do
        local commits=$(git log --all --oneline --name-only -- "$path" 2>/dev/null | grep -v "^$" | grep -v "^$path$" || true)

        if [ -n "$commits" ]; then
            issues_found=$((issues_found + 1))
            print_warning "Found commits modifying: ${BOLD}$path${NC}"

            git log --all --pretty=format:"  %C(yellow)%h%Creset %ai %C(cyan)%s%Creset" --name-status -- "$path" 2>/dev/null | head -10
            echo ""
        fi
    done

    # Check reserved files
    print_step "Checking for commits modifying reserved files..."
    echo ""

    for file in "${RESERVED_FILES[@]}"; do
        local commits=$(git log --all --oneline -- "$file" 2>/dev/null || true)

        if [ -n "$commits" ]; then
            issues_found=$((issues_found + 1))
            print_warning "Found commits modifying: ${BOLD}$file${NC}"

            git log --all --pretty=format:"  %C(yellow)%h%Creset %ai %C(cyan)%s%Creset" -- "$file" 2>/dev/null | head -10
            echo ""
        fi
    done

    # Check symlinks
    print_step "Checking symlink configuration..."
    echo ""

    if [ -L "wp-content/uploads" ]; then
        local target=$(readlink wp-content/uploads)
        if [ "$target" = "../uploads" ]; then
            print_success "wp-content/uploads → ../uploads (correct)"
        else
            print_warning "wp-content/uploads → $target (should be ../uploads)"
            issues_found=$((issues_found + 1))
        fi

        # Check if tracked by git
        if git ls-files --error-unmatch wp-content/uploads >/dev/null 2>&1; then
            local git_type=$(git ls-tree HEAD wp-content/uploads 2>/dev/null | awk '{print $2}')
            if [ "$git_type" = "blob" ]; then
                print_error "wp-content/uploads is tracked as a file (should be removed from history)"
                issues_found=$((issues_found + 1))
            else
                print_info "wp-content/uploads is tracked as symlink (mode 120000)"
            fi
        fi
    elif [ -e "wp-content/uploads" ]; then
        print_warning "wp-content/uploads exists but is not a symlink"
        issues_found=$((issues_found + 1))
    fi

    echo ""
    print_header "🧹 Scrub Results"

    if [ $issues_found -eq 0 ]; then
        print_success "Repository is squeaky clean! Ready for Pantheon. ✨"
    else
        print_warning "Found $issues_found issue(s) that need scrubbing"
        echo ""
        print_info "Run: ${BOLD}pantheon-scrub clean${NC} to scrub these issues"
    fi

    echo ""
}

# Fix symlinks
cmd_fix_symlinks() {
    print_header "🧹 Scrubbing Symlinks"

    get_repo_path "$1"

    local changes_made=0

    # Fix wp-content/uploads
    if [ -e "wp-content/uploads" ] || [ -L "wp-content/uploads" ]; then
        local current_target=""
        if [ -L "wp-content/uploads" ]; then
            current_target=$(readlink wp-content/uploads)
        fi

        if [ "$current_target" != "../uploads" ]; then
            print_step "Fixing wp-content/uploads symlink..."
            rm -rf wp-content/uploads
            cd wp-content
            ln -s ../uploads uploads
            cd ..
            print_success "Created: wp-content/uploads → ../uploads"
            changes_made=1
        else
            print_success "wp-content/uploads already correct"
        fi
    else
        print_step "Creating wp-content/uploads symlink..."
        cd wp-content
        ln -s ../uploads uploads
        cd ..
        print_success "Created: wp-content/uploads → ../uploads"
        changes_made=1
    fi

    # Fix wp-content/pv-uploads if it exists
    if [ -L "wp-content/pv-uploads" ]; then
        local current_target=$(readlink wp-content/pv-uploads)
        if [ "$current_target" != "../uploads" ]; then
            print_step "Fixing wp-content/pv-uploads symlink..."
            rm -rf wp-content/pv-uploads
            cd wp-content
            ln -s ../uploads pv-uploads
            cd ..
            print_success "Created: wp-content/pv-uploads → ../uploads"
            changes_made=1
        else
            print_success "wp-content/pv-uploads already correct"
        fi
    fi

    if [ $changes_made -eq 1 ]; then
        echo ""
        print_step "Staging symlinks..."
        git add wp-content/uploads 2>/dev/null || true
        git add wp-content/pv-uploads 2>/dev/null || true

        echo ""
        print_info "Symlinks staged. Verify with:"
        echo "  git ls-files -s wp-content/uploads"
        echo "  (Should show mode 120000 for symlink)"
        echo ""
        print_info "Commit with:"
        echo "  git commit -m 'Fix symlinks per Pantheon docs'"
    fi

    echo ""
}

# Clean git history
cmd_clean() {
    print_header "🧹 Deep Scrub - Cleaning Git History"

    check_dependencies
    get_repo_path "$1"

    # Show what will be cleaned
    print_step "The following paths will be removed from git history:"
    echo ""
    for path in "${RESERVED_PATHS[@]}"; do
        echo -e "  ${YELLOW}•${NC} $path"
    done
    for file in "${RESERVED_FILES[@]}"; do
        echo -e "  ${YELLOW}•${NC} $file"
    done

    echo ""
    print_warning "This will rewrite git history!"
    echo ""

    read -p "$(echo -e ${BOLD}Continue? [yes/no]:${NC} )" -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        print_info "Cancelled. No changes made."
        exit 0
    fi

    # Create backup
    local current_branch=$(git rev-parse --abbrev-ref HEAD)
    local backup_branch="${current_branch}-backup-$(date +%s)"

    print_step "Creating backup branch: $backup_branch"
    git branch "$backup_branch"
    print_success "Backup created"

    echo ""
    print_step "Removing reserved paths from history..."

    # Create temp file with paths to remove
    local temp_file=$(mktemp)
    printf '%s\n' "${RESERVED_PATHS[@]}" "${RESERVED_FILES[@]}" > "$temp_file"

    git filter-repo --invert-paths --paths-from-file "$temp_file" --force

    rm "$temp_file"

    echo ""
    print_success "Repository scrubbed clean! ✨"

    echo ""
    print_header "🧹 Next Steps"

    print_info "1. Verify the scrub:"
    echo "     pantheon-scrub scan"
    echo ""
    print_info "2. Push to Pantheon (after verification):"
    echo "     git push pantheon $current_branch --force-with-lease"
    echo ""
    print_warning "Backup branch: $backup_branch"
    echo "   Restore if needed: git checkout $backup_branch"
    echo ""
}

# Show usage
cmd_help() {
    echo -e "${BOLD}${CYAN}🧹 pantheon-scrub${NC}"
    echo -e "${CYAN}Automated repo cleanup for Pantheon deployments${NC}\n"
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "    pantheon-scrub <command> [repository-path]\n"
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "    ${GREEN}scan${NC}           Scan for issues that need scrubbing"
    echo -e "    ${GREEN}fix-symlinks${NC}   Fix symlinks to use relative paths"
    echo -e "    ${GREEN}clean${NC}          Deep scrub - removes problematic commits"
    echo -e "    ${GREEN}all${NC}            Full scrub (scan → fix → clean)"
    echo -e "    ${GREEN}help${NC}           Show this help message\n"
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo -e "    pantheon-scrub scan"
    echo -e "    pantheon-scrub scan /path/to/repo"
    echo -e "    pantheon-scrub fix-symlinks"
    echo -e "    pantheon-scrub clean"
    echo -e "    pantheon-scrub all\n"
    echo -e "${BOLD}WHAT GETS SCRUBBED:${NC}"
    echo -e "    ${CYAN}🧹${NC} Commits that modified wp-content/uploads"
    echo -e "    ${CYAN}🧹${NC} Commits that modified sites/default/files"
    echo -e "    ${CYAN}🧹${NC} Commits that modified pantheon.upstream.yml"
    echo -e "    ${CYAN}🧹${NC} Broken symlinks (fixes to relative paths)"
    echo -e "    ${CYAN}🧹${NC} Symlinks committed as files (converts to mode 120000)\n"
    echo -e "${BOLD}SAFETY FEATURES:${NC}"
    echo -e "    ${CHECK} Automatic backup branch before scrubbing"
    echo -e "    ${CHECK} Interactive confirmation required"
    echo -e "    ${CHECK} Never pushes automatically"
    echo -e "    ${CHECK} Works on any repository\n"
    echo -e "${BOLD}REQUIREMENTS:${NC}"
    echo -e "    git-filter-repo must be installed:"
    echo -e "      macOS:   brew install git-filter-repo"
    echo -e "      Linux:   pip install git-filter-repo\n"
    echo -e "${BOLD}DOCUMENTATION:${NC}"
    echo -e "    https://docs.pantheon.io/symlinks-assumed-write-access\n"
    echo -e "${CYAN}✨ Keep your Pantheon repos squeaky clean!${NC}\n"
}

# Run all steps
cmd_all() {
    print_header "🧹 pantheon-scrub - Full Scrub"

    print_step "Step 1: Scanning for issues..."
    cmd_scan "$1"

    echo ""
    read -p "$(echo -e ${BOLD}Continue to fix symlinks? [yes/no]:${NC} )" -r
    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        exit 0
    fi

    print_step "Step 2: Fixing symlinks..."
    cmd_fix_symlinks "$1"

    echo ""
    read -p "$(echo -e ${BOLD}Continue to clean git history? [yes/no]:${NC} )" -r
    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        exit 0
    fi

    print_step "Step 3: Cleaning git history..."
    cmd_clean "$1"
}

# Main
main() {
    local command="${1:-help}"
    local repo_path="${2:-.}"

    case "$command" in
        scan)
            cmd_scan "$repo_path"
            ;;
        fix-symlinks)
            cmd_fix_symlinks "$repo_path"
            ;;
        clean)
            cmd_clean "$repo_path"
            ;;
        all)
            cmd_all "$repo_path"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"

